# Browser-safe configuration only. Never put service-role, Resend, or Plaid secrets here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key
VITE_APP_URL=http://localhost:5173

# Production stays link/share-only until a sender domain is verified in Resend.
VITE_EMAIL_ENABLED=false

# Read-only reconciliation remains hidden until Plaid Sandbox is configured.
VITE_PLAID_ENABLED=false
