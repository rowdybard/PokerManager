# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY, and
# SUPABASE_SERVICE_ROLE_KEY for deployed Edge Functions.
ALLOWED_ORIGINS=https://poker-manager.pages.dev,http://localhost:5173

# Keep false until the client owns and verifies a sender domain in Resend.
EMAIL_ENABLED=false
EMAIL_PROCESSOR_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=Poker Manager <noreply@verified-client-domain.example>
RESEND_WEBHOOK_SECRET=replace-with-resend-webhook-secret

# Read-only Transactions reconciliation. Sandbox is the only approved default.
PLAID_ENABLED=false
PLAID_ENVIRONMENT=sandbox
PLAID_PRODUCTION_APPROVED=false
PLAID_CLIENT_ID=replace-with-plaid-client-id
PLAID_SECRET=replace-with-plaid-sandbox-secret
PLAID_WEBHOOK_URL=https://aflrgcrerzggnkhwenrr.supabase.co/functions/v1/plaid-webhook

# Base64url-encoded 32 random bytes. Never expose this through a VITE_ variable.
PLAID_TOKEN_ENCRYPTION_KEY=replace-with-base64url-key
